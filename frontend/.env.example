# Base URL of the Express backend (NOT Supabase directly)
API_BASE_URL=http://localhost:4000/api

# Only needed if any screen uses Supabase client-side (e.g. realtime
# subscriptions) — business logic itself always goes through the backend.
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
